{%- comment -%}
  Renders the news items from _news, newest first.
  Pass limit=true to honour page.announcements.limit (used on the about page).
{%- endcomment -%}
<div class="news">
  {%- if site.news == blank %}
    <p>No news so far...</p>
  {%- else %}
    {%- assign news = site.news | sort: 'date' | reverse -%}
    {%- if include.limit and page.announcements.limit -%}
      {%- assign news_limit = page.announcements.limit -%}
    {%- else -%}
      {%- assign news_limit = news | size -%}
    {%- endif -%}
    <table class="table table-sm table-borderless">
      {%- for item in news limit: news_limit %}
        <tr>
          <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
          <td>{{ item.content | remove: '<p>' | remove: '</p>' }}</td>
        </tr>
      {%- endfor %}
    </table>
  {%- endif %}
</div>
